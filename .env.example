# Copy file này thành ".env" rồi điền 2 giá trị lấy từ Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# CHỈ dùng khi cố ý chạy chế độ demo trên bản build production (không khuyến nghị). Mặc định /admin bị khóa nếu thiếu Supabase.
# VITE_ALLOW_DEMO=true

# Tên miền chính thức, dùng để tạo sitemap.xml + robots.txt khi build (vd https://layerlab3d.vn). Không bắt buộc ở máy dev.
